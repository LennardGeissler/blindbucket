# Build output. The binary name must be anchored to the repository root: an
# unanchored "blindbucket" would also match the cmd/blindbucket/ source directory.
/bin/
/dist/
/blindbucket

# Test and coverage artifacts
*.test
*.out
coverage.*

# Fuzzing corpus found by the local runner (seed corpora under testdata/ are committed)
/testdata/fuzz/

# Benchmark results
/bench/results/

# Demo state: the MinIO config, keyring, gateway log and payload that demo/setup.sh
# creates. The scripts and the recording itself are committed; what they generate is not.
/demo/.state/

# TLA+ tools, downloaded by `make tla-tools`. The model and its translation are
# committed; the 2 MB jar is not.
/.tools/
/spec/tla/states/
/spec/tla/*.old

# Local configuration and anything key-shaped — never committed
*.local.yaml
*.local.yml
keyring.json
blindbucket.env
/blindbucket.yaml
*.pem
*.key
*.crt

# Python bytecode from the reference decoder and the client tests
__pycache__/
*.py[cod]

# Editors and OS
.DS_Store
.idea/
.vscode/
